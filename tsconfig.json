{
  "version": "1.2.0",
  "compileOnSave": true,
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "strict": true,
    "outDir": "./target",
    "rootDir": "./src",
    "forceConsistentCasingInFileNames": true,
    "pretty": true,
    "removeComments": true,
    "incremental": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noUnusedParameters": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
  },
  "include": ["src/*.ts", "ambient.d.ts"],
}
